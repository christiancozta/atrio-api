{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/atrio-eval/1.0.0/arm-output.json",
  "title": "Saída cega de um braço experimental ATRIO",
  "type": "object",
  "required": ["schema_version", "status", "text"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": ["completed", "blocked"]
    },
    "text": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "text": {
            "type": "null"
          }
        }
      }
    }
  ]
}
