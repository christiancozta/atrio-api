# ATRIO Infra 1.0.0 — somente configuração não sigilosa.
# Senhas ficam em infra/secrets/, nunca neste arquivo.

ATRIO_INFRA_VERSION=1.0.0
ATRIO_API_VERSION=0.7.0
POSTGRES_IMAGE=postgres:18.4-alpine3.24
OLLAMA_IMAGE=ollama/ollama:0.32.4

# Altere se já houver serviço nativo ocupando uma dessas portas.
ATRIO_API_PORT=8080
OLLAMA_PORT=11434

# Modelo não é baixado automaticamente.
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=40960
OLLAMA_NUM_PREDICT=4096
